{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GWAP MASTER Decision Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "owner_system",
    "decision",
    "why",
    "authoritative_sources",
    "security_boundary",
    "review_trigger"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "RESEARCHED",
        "PILOT",
        "DEVNET_VERIFIED",
        "RELEASE_CANDIDATE",
        "PRODUCTION",
        "DEPRECATED",
        "SUPERSEDED",
        "BLOCKED"
      ]
    },
    "owner_system": {
      "type": "string",
      "minLength": 1
    },
    "user_outcome": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authoritative_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinned_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_boundary": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "string"
    },
    "test_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deployment_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string"
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "renumbered": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
